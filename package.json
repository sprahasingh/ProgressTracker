{
  "name": "progress-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prebuild": "npm run build:ai-help-bundle",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:e2e:achievements": "playwright test --config playwright.config.ts",
    "test:e2e:xp-history": "node scripts/run-xp-history-playwright.mjs",
    "test:e2e:xp-popup": "playwright test --config playwright.xp-popup.config.ts",
    "test:e2e:goals-local": "playwright test --config playwright.goals-local.config.ts",
    "test:e2e:scheduling-pre-release": "playwright test --config playwright.scheduling-local.config.ts",
    "test:e2e:streak-rules-local": "node scripts/run-streak-rules-local.mjs",
    "test:progression:integration": "bash scripts/test-progression-live.sh",
    "test:lifecycle-stress": "VITE_TRACKER_LIFECYCLE_STRESS=true vitest run src/db/trackerLifecycleStateMachine.test.ts",
    "test:watch": "vitest",
    "build:ai-help-bundle": "node scripts/build-ai-help-bundle.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@supabase/supabase-js": "^2.0.0",
    "dexie": "^4.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^7.9.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.0.1",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "vite": "^7.1.11",
    "vitest": "^4.1.11"
  }
}
