VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_project_key
# Public VAPID application-server key for authenticated device subscription registration.
# It is public by design. Never put the matching private key in a VITE_ variable.
VITE_VAPID_PUBLIC_KEY=replace_with_base64url_encoded_public_vapid_key
# Leave unset/false until the hosted schema v3 migration is applied and verified.
VITE_ENABLE_TRACKER_SCHEMA_V3=false
# Keep false until hosted permanent-deletion migration and pg_cron job are verified.
VITE_ENABLE_PERMANENT_DELETION=false
